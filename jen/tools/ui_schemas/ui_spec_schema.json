{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayDreams UI Spec",
  "description": "Per-screen visual specification — the contract between art direction (Jen) and the dev framework. Defines exact Godot node types, styles, colors, typography, and asset requirements for building a screen.",
  "type": "object",
  "required": ["screen", "viewport", "elements"],
  "properties": {
    "screen": {
      "type": "string",
      "description": "Screen id matching the corresponding screens-spec.json entry"
    },
    "source_screen_spec": {
      "type": "string",
      "description": "Reference to the screens-spec.json file this was derived from"
    },
    "viewport": {
      "type": "object",
      "description": "Viewport dimensions for this screen",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "description": "Color palette for the screen. Keys are semantic color names, values are hex colors (#RRGGBB or #RRGGBBAA)",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
      }
    },
    "typography": {
      "type": "object",
      "description": "Typography definitions mapping role names to font specifications",
      "additionalProperties": {
        "$ref": "#/definitions/typography_entry"
      }
    },
    "elements": {
      "type": "array",
      "description": "Root-level UI element tree for this screen",
      "items": {
        "$ref": "#/definitions/element"
      }
    },
    "styles": {
      "type": "object",
      "description": "Named style definitions referenced by elements via the style property",
      "additionalProperties": {
        "$ref": "#/definitions/style_definition"
      }
    },
    "assets_needed": {
      "type": "array",
      "description": "Assets that need to be generated or sourced for this screen",
      "items": {
        "$ref": "#/definitions/asset_requirement"
      }
    }
  },
  "definitions": {
    "typography_entry": {
      "type": "object",
      "description": "Font specification for a typography role",
      "required": ["font", "size"],
      "properties": {
        "font": {
          "type": "string",
          "description": "Godot resource path to the font (res://...)"
        },
        "size": {
          "type": "integer",
          "description": "Font size in pixels",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "description": "A UI element mapped to a specific Godot node with visual properties",
      "required": ["id", "node_type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique element identifier"
        },
        "node_type": {
          "type": "string",
          "enum": [
            "Button",
            "Label",
            "TextureRect",
            "NinePatchRect",
            "VBoxContainer",
            "HBoxContainer",
            "GridContainer",
            "MarginContainer",
            "PanelContainer",
            "ScrollContainer",
            "TabContainer",
            "Control",
            "ColorRect",
            "Panel",
            "RichTextLabel",
            "ProgressBar",
            "HSlider",
            "VSlider",
            "CheckButton",
            "CheckBox",
            "OptionButton",
            "LineEdit",
            "TextEdit",
            "TextureButton"
          ],
          "description": "Godot node type to instantiate"
        },
        "text": {
          "type": "string",
          "description": "Text content for this element"
        },
        "asset": {
          "type": "string",
          "description": "Godot resource path to an asset (res://...)"
        },
        "anchor_preset": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "full_rect",
                "center",
                "center_top",
                "center_bottom",
                "center_left",
                "center_right",
                "top_left",
                "top_right",
                "bottom_left",
                "bottom_right",
                "top_wide",
                "bottom_wide",
                "left_wide",
                "right_wide"
              ]
            },
            {
              "type": "integer",
              "description": "Godot anchor preset number"
            }
          ],
          "description": "Anchor preset (named string or Godot preset integer)"
        },
        "anchor": {
          "type": "object",
          "description": "Fine-grained anchor configuration",
          "properties": {
            "preset": {
              "type": "string",
              "description": "Base anchor preset name"
            },
            "offset_x": {
              "type": "number",
              "description": "Horizontal offset from anchor position"
            },
            "offset_y": {
              "type": "number",
              "description": "Vertical offset from anchor position"
            }
          },
          "additionalProperties": false
        },
        "min_size": {
          "type": "array",
          "description": "Minimum size [width, height] in pixels",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "style": {
          "type": "string",
          "description": "References a key in the top-level styles object"
        },
        "font_key": {
          "type": "string",
          "description": "References a key in the top-level typography object"
        },
        "color_key": {
          "type": "string",
          "description": "References a key in the top-level palette object"
        },
        "separation": {
          "type": "integer",
          "description": "Separation between children in pixels (for container nodes)"
        },
        "columns": {
          "type": "integer",
          "description": "Number of columns (for GridContainer)",
          "minimum": 1
        },
        "stretch_mode": {
          "type": "string",
          "description": "Texture stretch mode (for TextureRect)"
        },
        "h_align": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "description": "Horizontal alignment"
        },
        "v_align": {
          "type": "string",
          "enum": ["top", "center", "bottom"],
          "description": "Vertical alignment"
        },
        "children": {
          "type": "array",
          "description": "Child elements (recursive tree structure)",
          "items": {
            "$ref": "#/definitions/element"
          }
        }
      },
      "additionalProperties": false
    },
    "style_definition": {
      "type": "object",
      "description": "StyleBox definition for theming Godot UI nodes",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["StyleBoxFlat", "StyleBoxTexture"],
          "description": "Godot StyleBox type"
        },
        "bg_color": {
          "type": "string",
          "description": "Background color (hex)",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "border_color": {
          "type": "string",
          "description": "Border color (hex)",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "border_width": {
          "oneOf": [
            {
              "type": "integer",
              "description": "Uniform border width in pixels",
              "minimum": 0
            },
            {
              "type": "object",
              "description": "Per-side border widths",
              "properties": {
                "left": { "type": "integer", "minimum": 0 },
                "top": { "type": "integer", "minimum": 0 },
                "right": { "type": "integer", "minimum": 0 },
                "bottom": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "corner_radius": {
          "oneOf": [
            {
              "type": "integer",
              "description": "Uniform corner radius in pixels",
              "minimum": 0
            },
            {
              "type": "object",
              "description": "Per-corner radii",
              "properties": {
                "top_left": { "type": "integer", "minimum": 0 },
                "top_right": { "type": "integer", "minimum": 0 },
                "bottom_right": { "type": "integer", "minimum": 0 },
                "bottom_left": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "content_margin": {
          "type": "array",
          "description": "Content margins [left, top, right, bottom] in pixels",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "shadow_color": {
          "type": "string",
          "description": "Shadow color (hex)",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "shadow_offset": {
          "type": "array",
          "description": "Shadow offset [x, y] in pixels",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "shadow_size": {
          "type": "integer",
          "description": "Shadow blur size in pixels",
          "minimum": 0
        },
        "font_color": {
          "type": "string",
          "description": "Font color (hex)",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "font_color_hover": {
          "type": "string",
          "description": "Font color on hover (hex)",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "font_color_pressed": {
          "type": "string",
          "description": "Font color when pressed (hex)",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "hover": {
          "type": "object",
          "description": "Style overrides for hover state"
        },
        "pressed": {
          "type": "object",
          "description": "Style overrides for pressed state"
        },
        "disabled": {
          "type": "object",
          "description": "Style overrides for disabled state"
        }
      },
      "additionalProperties": false
    },
    "asset_requirement": {
      "type": "object",
      "description": "An asset that needs to be generated or sourced for this screen",
      "required": ["id", "type", "size"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Asset identifier"
        },
        "type": {
          "type": "string",
          "enum": ["background", "icon", "texture", "nine_patch", "decoration"],
          "description": "Asset category"
        },
        "size": {
          "type": "array",
          "description": "Required size [width, height] in pixels",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "prompt_hint": {
          "type": "string",
          "description": "Description for AI image generation"
        },
        "format": {
          "type": "string",
          "enum": ["png", "svg"],
          "description": "Output file format",
          "default": "png"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
